# Shared identity / challenge hosts: optional companion to ai.list.
# Loading this file routes ALL requests to these hostnames to the chosen AI policy.
# Do not replace with google.com/githubusercontent.com/cloudflare.com wide suffixes.

# Cloudflare challenge used by AI browser sign-in; also affects other sites using this host
DOMAIN,challenges.cloudflare.com

# Google OAuth for Antigravity/Gemini; also affects other Google sign-ins
DOMAIN,accounts.google.com
DOMAIN,oauth2.googleapis.com
DOMAIN,oauth2.mtls.googleapis.com
DOMAIN,www.googleapis.com


# Known shared feature/configuration endpoints (not every tenant of these providers)
DOMAIN,api.statsig.com
DOMAIN,featuregates.org
DOMAIN,events.statsigapi.net
DOMAIN,clientstream.launchdarkly.com
DOMAIN,events.launchdarkly.com
DOMAIN,app.launchdarkly.com
DOMAIN,cdn.usefathom.com
